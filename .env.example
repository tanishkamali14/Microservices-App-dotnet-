# Passwords for the local docker compose environment.
# Copy this file to .env and choose your own values:  cp .env.example .env
# .env is git-ignored, so the real values never end up in the repository.
# Avoid ; @ : / and quotes: the values are embedded in connection strings and URLs.

# PostgreSQL (Discount service)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# SQL Server (Ordering service). At least 8 characters with upper case, lower case,
# digits and a symbol, or the container refuses to start.
MSSQL_SA_PASSWORD=Change-me-1234

# RabbitMQ (Basket and Ordering services)
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change-me

# pgAdmin web UI on http://localhost:5050
PGADMIN_PASSWORD=change-me
