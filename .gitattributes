# Store text files with LF in the repository and let Git pick the
# platform's native line ending on checkout.
* text=auto

# Files that are executed or parsed inside Linux containers must stay LF.
*.sh text eol=lf
.env* text eol=lf
Dockerfile text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
